{
  "repository": "Vorce-Studios/Vorce",
  "wake_intervals": {
    "planning_minutes": 60,
    "monitoring_minutes": 10
  },
  "jules": {
    "max_daily_sessions": 100,
    "max_concurrent_sessions": 15,
    "auto_approve_plans": true,
    "auto_retry_feedback_max": 3,
    "auto_merge_approved_prs": true,
    "monitoring_refill_enabled": true,
    "monitoring_refill_buffer_size": 30
  },
  "gemini_worktree_path": "../VjMapper-gemini",
  "issue_filters": {
    "include_labels": [
      "jules-task",
      "bug",
      "priority: critical"
    ],
    "exclude_labels": [
      "wontfix",
      "duplicate",
      "on-hold",
      "status: in-progress",
      "status: needs-review",
      "status: needs-testing",
      "status: blocked",
      "status: ready-to-merge"
    ],
    "autopilot_label": "autopilot-created"
  },
  "max_issues_per_planning_cycle": 30,
  "dual_ceo": {
    "enabled": true,
    "ceo_alpha_chain": [
      "codex_orchestrator:planning",
      "gemini_cli:balanced"
    ],
    "ceo_beta_chain": [
      "gemini_cli:balanced"
    ],
    "max_deliberation_rounds": 3,
    "deliberation_tasks": [
      "complex_review"
    ],
    "fallback_to_single": true,
    "log_deliberations": true
  },
  "planning_sequence": [
    {
      "id": "jules_sync",
      "prompt_ref": "planning_jules_sync",
      "tier": "fast",
      "label": "Jules-Status Sync"
    },
    {
      "id": "pr_sync",
      "prompt_ref": "planning_pr_sync",
      "tier": "fast",
      "label": "PR-Status Sync"
    },
    {
      "id": "backlog_analysis",
      "prompt_ref": "planning_analysis",
      "tier": "balanced",
      "label": "Backlog-Analyse"
    },
    {
      "id": "task_generation",
      "prompt_ref": "planning_proposal",
      "tier": "balanced",
      "label": "Task-Generierung"
    },
    {
      "id": "final_synthesis",
      "prompt_ref": "planning_synthesis",
      "tier": "high",
      "label": "Master-Plan Synthese"
    }
  ],
  "monitoring_sequence": [
    {
      "id": "session_health",
      "prompt_ref": "monitor_sessions",
      "tier": "fast",
      "label": "Session Health Check"
    },
    {
      "id": "pr_ci_validation",
      "prompt_ref": "monitor_prs",
      "tier": "fast",
      "label": "PR CI-Validierung"
    },
    {
      "id": "conflict_remediation",
      "prompt_ref": "monitor_conflicts",
      "tier": "balanced",
      "label": "Merge-Konflikt Remediation"
    },
    {
      "id": "monitoring_synthesis",
      "prompt_ref": "monitoring_synthesis",
      "tier": "high",
      "label": "Monitoring Synthese & Entscheidung"
    }
  ],
  "monitoring_sequence_layout": {},
  "audit_sequence": [
    {
      "id": "consistency_audit",
      "prompt_ref": "audit_consistency",
      "tier": "balanced",
      "label": "Daten-Konsistenz Audit"
    },
    {
      "id": "performance_audit",
      "prompt_ref": "audit_performance",
      "tier": "balanced",
      "label": "Autopilot Performance Audit"
    },
    {
      "id": "audit_synthesis",
      "prompt_ref": "audit_synthesis",
      "tier": "high",
      "label": "Audit Synthese & Konsolidierung"
    }
  ],
  "reviews": {
    "enabled": true,
    "reviewer_provider": "claude_code",
    "require_review_before_merge": true,
    "default_review_type": "simple_review",
    "complex_review_model_tier": "balanced"
  }
}
