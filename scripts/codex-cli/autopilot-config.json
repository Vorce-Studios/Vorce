{
  "repository": "Vorce-Studios/Vorce",
  "wake_intervals": {
    "planning_minutes": 60,
    "monitoring_minutes": 5
  },
  "jules": {
    "max_daily_sessions": 100,
    "max_concurrent_sessions": 15,
    "auto_approve_plans": true,
    "auto_retry_feedback_max": 2,
    "auto_merge_approved_prs": true
  },
  "gemini_worktree_path": "../VjMapper-gemini",
  "issue_filters": {
    "include_labels": ["jules-task", "priority-high", "bug"],
    "exclude_labels": ["wontfix", "duplicate", "on-hold"],
    "autopilot_label": "autopilot-created"
  },
  "max_issues_per_planning_cycle": 5,
  "dual_ceo": {
    "enabled": true,
    "ceo_alpha_chain": ["codex_orchestrator:planning", "gemini_cli:balanced"],
    "ceo_beta_chain": ["gemini_cli:balanced"],
    "max_deliberation_rounds": 3,
    "deliberation_tasks": ["planning", "complex_review"],
    "fallback_to_single": true,
    "log_deliberations": true
  }
}
