{
  "repository": "Vorce-Studios/Vorce",
  "wake_intervals": {
    "planning_minutes": 120,
    "check_and_doing_minutes": 15,
    "memory_optimization_minutes": 60,
    "monitoring_minutes": 10
  },
  "jules": {
    "max_daily_sessions": 100,
    "max_concurrent_sessions": 15,
    "auto_approve_plans": true,
    "auto_retry_feedback_max": 3
  },
  "gemini_worktree_path": "../VjMapper-gemini",
  "issue_filters": {
    "include_labels": [
      "jules-task",
      "bug",
      "priority: critical"
    ],
    "exclude_labels": [
      "wontfix",
      "duplicate",
      "on-hold",
      "status: in-progress",
      "status: needs-review",
      "status: needs-testing",
      "status: blocked",
      "status: ready-to-merge"
    ],
    "autopilot_label": "autopilot-created"
  },
  "max_issues_per_planning_cycle": 10,
  "dual_ceo": {
    "enabled": true,
    "ceo_chain": [
      "codex_orchestrator:planning",
      "claude_code:balanced"
    ],
    "qa_manager_chain": [
      "gemini_cli:premium",
      "kiro_cli:default"
    ],
    "max_deliberation_rounds": 3,
    "deliberation_tasks": [
      "planning",
      "complex_review"
    ],
    "fallback_to_single": true,
    "log_deliberations": true
  },
  "working_sessions": {
    "preferred_agents": [
      "claude_code",
      "gemini_cli",
      "cline_cli"
    ]
  },
  "router_rules": {
    "Planning": [
      {
        "id": "01",
        "name": "DataSync",
        "script": "src/runs/MAIN-RUN-01_Planning/SUB-RUNS/SUB-RUN-01_MR-01_Planning__DataSync/SUB-RUN-01_MR-01_Planning__DataSync.ps1",
        "enabled": true
      },
      {
        "id": "02",
        "name": "Triage",
        "script": "src/runs/MAIN-RUN-01_Planning/SUB-RUNS/SUB-RUN-02_MR-01_Planning__Triage/SUB-RUN-02_MR-01_Planning__Triage.ps1",
        "enabled": true
      },
      {
        "id": "03",
        "name": "Strategy",
        "script": "src/runs/MAIN-RUN-01_Planning/SUB-RUNS/SUB-RUN-03_MR-01_Planning__Strategy/SUB-RUN-03_MR-01_Planning__Strategy.ps1",
        "enabled": true
      },
      {
        "id": "04",
        "name": "Delegation",
        "script": "src/runs/MAIN-RUN-01_Planning/SUB-RUNS/SUB-RUN-04_MR-01_Planning__Delegation/SUB-RUN-04_MR-01_Planning__Delegation.ps1",
        "enabled": true
      }
    ],
    "CheckAndDoing": [
      {
        "id": "01",
        "name": "SessionSync",
        "script": "src/runs/MAIN-RUN-02_CheckAndDoing/SUB-RUNS/SUB-RUN-01_MR-02_CheckAndDoing__SessionSync/SUB-RUN-01_MR-02_CheckAndDoing__SessionSync.ps1",
        "enabled": true
      },
      {
        "id": "02",
        "name": "JulesCheck",
        "script": "src/runs/MAIN-RUN-02_CheckAndDoing/SUB-RUNS/SUB-RUN-02_MR-02_CheckAndDoing__JulesCheck/SUB-RUN-02_MR-02_CheckAndDoing__JulesCheck.ps1",
        "enabled": true
      },
      {
        "id": "03",
        "name": "LocalAgentCheck",
        "script": "src/runs/MAIN-RUN-02_CheckAndDoing/SUB-RUNS/SUB-RUN-03_MR-02_CheckAndDoing__LocalAgentCheck/SUB-RUN-03_MR-02_CheckAndDoing__LocalAgentCheck.ps1",
        "enabled": true
      },
      {
        "id": "04",
        "name": "ReviewDispatch",
        "script": "src/runs/MAIN-RUN-02_CheckAndDoing/SUB-RUNS/SUB-RUN-04_MR-02_CheckAndDoing__ReviewDispatch/SUB-RUN-04_MR-02_CheckAndDoing__ReviewDispatch.ps1",
        "enabled": true
      },
      {
        "id": "05",
        "name": "JulesRefill",
        "script": "src/runs/MAIN-RUN-02_CheckAndDoing/SUB-RUNS/SUB-RUN-05_MR-02_CheckAndDoing__JulesRefill/SUB-RUN-02_MR-02_CheckAndDoing__JulesRefill.ps1",
        "enabled": true
      },
      {
        "id": "06",
        "name": "Housekeeping",
        "script": "src/runs/MAIN-RUN-02_CheckAndDoing/SUB-RUNS/SUB-RUN-06_MR-02_CheckAndDoing__Housekeeping/SUB-RUN-06_MR-02_CheckAndDoing__Housekeeping.ps1",
        "enabled": true
      }
    ],
    "Audit": [
      {
        "id": "01",
        "name": "DataSync",
        "script": "src/runs/MAIN-RUN-03_Audit/SUB-RUNS/SUB-RUN-01_MR-03_Audit__DataSync/SUB-RUN-01_MR-03_Audit__DataSync.ps1",
        "enabled": true
      },
      {
        "id": "02",
        "name": "ComplianceCheck",
        "script": "src/runs/MAIN-RUN-03_Audit/SUB-RUNS/SUB-RUN-02_MR-03_Audit__ComplianceCheck/SUB-RUN-02_MR-03_Audit__ComplianceCheck.ps1",
        "enabled": true
      },
      {
        "id": "03",
        "name": "JulesSupervision",
        "script": "src/runs/MAIN-RUN-03_Audit/SUB-RUNS/SUB-RUN-03_MR-03_Audit__JulesSupervision/SUB-RUN-03_MR-03_Audit__JulesSupervision.ps1",
        "enabled": true
      },
      {
        "id": "04",
        "name": "AlertDisposition",
        "script": "src/runs/MAIN-RUN-03_Audit/SUB-RUNS/SUB-RUN-04_MR-03_Audit__AlertDisposition/SUB-RUN-04_MR-03_Audit__AlertDisposition.ps1",
        "enabled": true
      }
    ],
    "Optimizer": [
      {
        "id": "01",
        "name": "DataSync",
        "script": "src/runs/MAIN-RUN-04_Optimizer/SUB-RUNS/SUB-RUN-01_MR-04_Optimizer__DataSync/SUB-RUN-01_MR-04_Optimizer__DataSync.ps1",
        "enabled": true
      },
      {
        "id": "02",
        "name": "MemoryMaintenance",
        "script": "src/runs/MAIN-RUN-04_Optimizer/SUB-RUNS/SUB-RUN-02_MR-04_Optimizer__MemoryMaintenance/SUB-RUN-02_MR-04_Optimizer__MemoryMaintenance.ps1",
        "enabled": true
      },
      {
        "id": "03",
        "name": "SystemAnalysis",
        "script": "src/runs/MAIN-RUN-04_Optimizer/SUB-RUNS/SUB-RUN-03_MR-04_Optimizer__SystemAnalysis/SUB-RUN-03_MR-04_Optimizer__SystemAnalysis.ps1",
        "enabled": true
      }
    ]
  }
}
