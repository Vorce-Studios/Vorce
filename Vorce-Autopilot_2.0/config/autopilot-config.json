{
  "repository": "Vorce-Studios/Vorce",
  "wake_intervals": {
    "planning_minutes": 120,
    "monitoring_minutes": 15
  },
  "jules": {
    "max_daily_sessions": 100,
    "max_concurrent_sessions": 15,
    "auto_approve_plans": true,
    "auto_retry_feedback_max": 3
  },
  "gemini_worktree_path": "../VjMapper-gemini",
  "issue_filters": {
    "include_labels": [
      "jules-task",
      "bug",
      "priority: critical"
    ],
    "exclude_labels": [
      "wontfix",
      "duplicate",
      "on-hold",
      "status: in-progress",
      "status: needs-review",
      "status: needs-testing",
      "status: blocked",
      "status: ready-to-merge"
    ],
    "autopilot_label": "autopilot-created"
  },
  "max_issues_per_planning_cycle": 10,
  "dual_ceo": {
    "enabled": true,
    "ceo_chain": [
      "codex_orchestrator:planning",
      "claude_code:balanced"
    ],
    "qa_manager_chain": [
      "gemini_cli:premium",
      "kiro_cli:default"
    ],
    "max_deliberation_rounds": 3,
    "deliberation_tasks": [
      "planning",
      "complex_review"
    ],
    "fallback_to_single": true,
    "log_deliberations": true
  },
  "working_sessions": {
    "preferred_agents": [
      "claude_code",
      "gemini_cli",
      "cline_cli"
    ]
  },
  "router_rules": {
    "Planning": [
      { "id": "01", "name": "DataSync", "script": "src/runs/SUB-RUN/SUB-RUN-01_MR-01_Planning__DataSync.ps1", "enabled": true },
      { "id": "02", "name": "Triage", "script": "src/runs/SUB-RUN/SUB-RUN-02_MR-01_Planning__Triage.ps1", "enabled": true },
      { "id": "03", "name": "Strategy", "script": "src/runs/SUB-RUN/SUB-RUN-03_MR-01_Planning__Strategy.ps1", "enabled": true },
      { "id": "04", "name": "Delegation", "script": "src/runs/SUB-RUN/SUB-RUN-04_MR-01_Planning__Delegation.ps1", "enabled": true },
      { "id": "05", "name": "Optimization", "script": "src/runs/SUB-RUN/SUB-RUN-05_MR-01_Planning__Optimization.ps1", "enabled": true }
    ],
    "Monitoring": [
      { "id": "01", "name": "SystemHealthCheck", "script": "src/runs/SUB-RUN/SUB-RUN-01_MR-02_Monitoring__SystemHealthCheck.ps1", "enabled": true },
      { "id": "02", "name": "LegacyMonitoring", "script": "src/runs/SUB-RUN/SUB-RUN-02_MR-02_Monitoring__LegacyFallback.ps1", "enabled": true }
    ],
    "Audit": [
      { "id": "01", "name": "ConsistencyAudit", "script": "src/runs/SUB-RUN/SUB-RUN-01_MR-03_Audit__ConsistencyAudit.ps1", "enabled": true },
      { "id": "02", "name": "LegacyAudit", "script": "src/runs/SUB-RUN/SUB-RUN-02_MR-03_Audit__LegacyFallback.ps1", "enabled": true }
    ]
  }
}
