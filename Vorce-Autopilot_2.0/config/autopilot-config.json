{
  "repository": "Vorce-Studios/Vorce",
  "wake_intervals": {
    "planning_minutes": 120,
    "monitoring_minutes": 15
  },
  "jules": {
    "max_daily_sessions": 100,
    "max_concurrent_sessions": 15,
    "auto_approve_plans": true,
    "auto_retry_feedback_max": 3
  },
  "gemini_worktree_path": "../VjMapper-gemini",
  "issue_filters": {
    "include_labels": [
      "jules-task",
      "bug",
      "priority: critical"
    ],
    "exclude_labels": [
      "wontfix",
      "duplicate",
      "on-hold",
      "status: in-progress",
      "status: needs-review",
      "status: needs-testing",
      "status: blocked",
      "status: ready-to-merge"
    ],
    "autopilot_label": "autopilot-created"
  },
  "max_issues_per_planning_cycle": 10,
  "dual_ceo": {
    "enabled": true,
    "ceo_chain": [
      "codex_orchestrator:planning",
      "claude_code:balanced"
    ],
    "qa_manager_chain": [
      "gemini_cli:premium",
      "kiro_cli:default"
    ],
    "max_deliberation_rounds": 3,
    "deliberation_tasks": [
      "planning",
      "complex_review"
    ],
    "fallback_to_single": true,
    "log_deliberations": true
  },
  "working_sessions": {
    "preferred_agents": [
      "claude_code",
      "gemini_cli",
      "cline_cli"
    ]
  },
  "router_rules": {
    "Planning": [
      { "name": "SR-01_ContextGathering", "script": "src/runs/sub/SR-01_ContextGathering.ps1", "enabled": true },
      { "name": "SR-00_LegacyPlanningFallback", "script": "src/runs/sub/SR-00_LegacyPlanningFallback.ps1", "enabled": true }
    ],
    "Monitoring": [
      { "name": "SR-01_SystemHealthCheck", "script": "src/runs/sub/SR-01_SystemHealthCheck.ps1", "enabled": true },
      { "name": "SR-00_LegacyMonitoringFallback", "script": "src/runs/sub/SR-00_LegacyMonitoringFallback.ps1", "enabled": true }
    ],
    "Audit": [
      { "name": "SR-01_ConsistencyAudit", "script": "src/runs/sub/SR-01_ConsistencyAudit.ps1", "enabled": true },
      { "name": "SR-00_LegacyAuditFallback", "script": "src/runs/sub/SR-00_LegacyAuditFallback.ps1", "enabled": true }
    ]
  }
  }
